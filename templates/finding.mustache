{{!
    @template local_auditenhance/finding

    One check with its finding, explanation, fix steps, link, sample and actions.

    Example context (json):
    {
        "domid": "local-auditenhance-x", "name": "Debug messages", "areaname": "Security", "areaurl": "#",
        "failed": true, "severity": "high", "severityname": "High", "statusname": "Failed",
        "summary": "Debug messages are shown to users.", "why": "They reveal paths.", "fix": "Turn them off.",
        "link": "#", "hassample": true, "sample": [{"label": "Admin", "url": "#"}], "itemcount": 1,
        "muted": false, "when": "26/11/26, 10:00", "live": true, "hasactions": true,
        "actions": [{"url": "#", "text": "Mute"}], "showarea": true
    }
}}
<div class="card mb-3 local-auditenhance-finding" id="{{domid}}">
    <div class="card-body">
        <h4 class="h6 card-title mb-1">
            {{#failed}}<span class="badge local-auditenhance-severity-{{severity}}">{{severityname}}</span>{{/failed}}
            {{^failed}}<span class="badge local-auditenhance-status-{{status}}">{{statusname}}</span>{{/failed}}
            {{name}}
            {{#showarea}}<small class="text-muted">· <a href="{{areaurl}}">{{areaname}}</a></small>{{/showarea}}
        </h4>
        <p class="mb-2">{{summary}}</p>
        {{#muted}}<p class="small mb-2"><strong>{{#str}} mutedreason, local_auditenhance {{/str}}</strong> {{mutereason}}</p>{{/muted}}
        <details>
            <summary class="small">{{#str}} details, local_auditenhance {{/str}}</summary>
            {{#why}}<p class="mt-2 mb-1"><strong>{{#str}} whyitmatters, local_auditenhance {{/str}}</strong> {{why}}</p>{{/why}}
            {{#fix}}<p class="mb-1"><strong>{{#str}} howtofix, local_auditenhance {{/str}}</strong> {{fix}}</p>{{/fix}}
            {{#hassample}}
                <ul class="small mb-1">
                    {{#sample}}<li>{{#url}}<a href="{{url}}">{{label}}</a>{{/url}}{{^url}}{{label}}{{/url}}</li>{{/sample}}
                </ul>
                {{#itemcount}}<p class="small text-muted mb-1">{{#str}} itemstotal, local_auditenhance, {{itemcount}} {{/str}}</p>{{/itemcount}}
            {{/hassample}}
            {{#when}}<p class="small text-muted mb-0">{{#live}}{{#str}} checkedlive, local_auditenhance, {{when}} {{/str}}{{/live}}{{^live}}{{#str}} checkedrun, local_auditenhance, {{when}} {{/str}}{{/live}}</p>{{/when}}
        </details>
        <div class="mt-2">
            {{#link}}<a class="btn btn-sm btn-primary" href="{{link}}">{{#str}} fixlink, local_auditenhance {{/str}}</a>{{/link}}
            {{#actions}}<a class="btn btn-sm btn-secondary" href="{{url}}">{{text}}</a> {{/actions}}
        </div>
    </div>
</div>
