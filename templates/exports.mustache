{{!
    @template local_auditenhance/exports

    Download buttons of the export formats.

    Example context (json):
    {"hasexports": true, "exports": [{"name": "CSV", "url": "#"}]}
}}
{{#hasexports}}
<div class="mb-3">
    <span class="mr-2 me-2">{{#str}} download, local_auditenhance {{/str}}</span>
    {{#exports}}<a class="btn btn-sm btn-outline-secondary" href="{{url}}">{{name}}</a> {{/exports}}
</div>
{{/hasexports}}
