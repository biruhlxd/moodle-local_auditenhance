{{!
    @template local_auditenhance/score

    A score badge.

    Example context (json):
    {"hasscore": true, "score": 82, "band": "good"}
}}
{{#hasscore}}<span class="local-auditenhance-score local-auditenhance-band-{{band}}">{{score}}</span>{{/hasscore}}
{{^hasscore}}<span class="local-auditenhance-score local-auditenhance-band-none" title="{{#str}} noscore, local_auditenhance {{/str}}">–</span>{{/hasscore}}
