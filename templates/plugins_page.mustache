{{!
    @template local_auditenhance/plugins_page

    Findings per plugin with severity, or the findings of one plugin.

    Example context (json):
    {
        "hasrun": true, "rundate": "26 November 2026", "detail": false, "hasplugins": true, "hasexports": false,
        "exports": [],
        "plugins": [{"name": "Example (local_example)", "url": "#", "severity": "high", "severityname": "High",
                     "items": 3, "counts": [{"severity": "high", "name": "High", "count": 3}]}]
    }
}}
<div class="local-auditenhance-plugins">
    {{^hasrun}}<div class="alert alert-info">{{#str}} noresultsyet, local_auditenhance {{/str}}</div>{{/hasrun}}
    {{#hasrun}}
        <p class="text-muted">{{#str}} lastrun, local_auditenhance, {{rundate}} {{/str}}</p>
        {{> local_auditenhance/exports }}
        {{#detail}}
            <h3 class="h5">{{pluginname}}</h3>
            <p><a href="{{backurl}}">{{#str}} allplugins, local_auditenhance {{/str}}</a></p>
            {{^hasitems}}<div class="alert alert-success">{{#str}} nopluginissues, local_auditenhance {{/str}}</div>{{/hasitems}}
            {{#hasitems}}
                <table class="table table-striped generaltable">
                    <thead><tr>
                        <th scope="col">{{#str}} severity, local_auditenhance {{/str}}</th>
                        <th scope="col">{{#str}} check, local_auditenhance {{/str}}</th>
                        <th scope="col">{{#str}} finding, local_auditenhance {{/str}}</th>
                    </tr></thead>
                    <tbody>
                        {{#items}}<tr>
                            <td><span class="badge local-auditenhance-severity-{{severity}}">{{severityname}}</span></td>
                            <td>{{check}}</td>
                            <td>{{label}}
                                {{#muteurl}}<br><a class="small" href="{{muteurl}}">{{#str}} muteitem, local_auditenhance {{/str}}</a>{{/muteurl}}
                                {{#mutewholeurl}} · <a class="small" href="{{mutewholeurl}}">{{#str}} muteitemallplugin, local_auditenhance {{/str}}</a>{{/mutewholeurl}}
                            </td>
                        </tr>{{/items}}
                    </tbody>
                </table>
            {{/hasitems}}
        {{/detail}}
        {{^detail}}
            {{^hasplugins}}<div class="alert alert-success">{{#str}} nopluginissues, local_auditenhance {{/str}}</div>{{/hasplugins}}
            {{#hasplugins}}
                <table class="table table-striped generaltable">
                    <thead><tr>
                        <th scope="col">{{#str}} plugin {{/str}}</th>
                        <th scope="col">{{#str}} severity, local_auditenhance {{/str}}</th>
                        <th scope="col">{{#str}} findings, local_auditenhance {{/str}}</th>
                    </tr></thead>
                    <tbody>
                        {{#plugins}}<tr>
                            <td><a href="{{url}}">{{name}}</a></td>
                            <td><span class="badge local-auditenhance-severity-{{severity}}">{{severityname}}</span></td>
                            <td>{{#counts}}<span class="badge local-auditenhance-severity-{{severity}}">{{name}}: {{count}}</span> {{/counts}}</td>
                        </tr>{{/plugins}}
                    </tbody>
                </table>
            {{/hasplugins}}
        {{/detail}}
    {{/hasrun}}
</div>
