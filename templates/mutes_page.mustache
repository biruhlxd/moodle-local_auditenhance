{{!
    @template local_auditenhance/mutes_page

    Muted checks with their reasons.

    Example context (json):
    {"hasmutes": true, "mutes": [{"name": "Guest access", "area": "Security", "reason": "Needed", "user": "Admin",
     "time": "26/11/26", "unmuteurl": "#"}]}
}}
<div class="local-auditenhance-mutes">
    <p>{{#str}} mutesintro, local_auditenhance {{/str}}</p>
    {{^hasmutes}}<div class="alert alert-info">{{#str}} nomutes, local_auditenhance {{/str}}</div>{{/hasmutes}}
    {{#hasmutes}}
        <table class="table table-striped generaltable">
            <thead><tr>
                <th scope="col">{{#str}} check, local_auditenhance {{/str}}</th>
                <th scope="col">{{#str}} area, local_auditenhance {{/str}}</th>
                <th scope="col">{{#str}} reason, local_auditenhance {{/str}}</th>
                <th scope="col">{{#str}} mutedby, local_auditenhance {{/str}}</th>
                <th scope="col"><span class="sr-only visually-hidden">{{#str}} actions {{/str}}</span></th>
            </tr></thead>
            <tbody>
                {{#mutes}}<tr>
                    <td>{{name}}</td>
                    <td>{{area}}</td>
                    <td>{{{reason}}}</td>
                    <td>{{user}}<br><small class="text-muted">{{time}}</small></td>
                    <td>{{#unmuteurl}}<a class="btn btn-sm btn-secondary" href="{{unmuteurl}}">{{#str}} unmute, local_auditenhance {{/str}}</a>{{/unmuteurl}}</td>
                </tr>{{/mutes}}
            </tbody>
        </table>
    {{/hasmutes}}
    <h3 class="h5 mt-4">{{#str}} muteditems, local_auditenhance {{/str}}</h3>
    <p>{{#str}} muteditemsintro, local_auditenhance {{/str}}</p>
    {{^hasitemmutes}}<div class="alert alert-info">{{#str}} noitemmutes, local_auditenhance {{/str}}</div>{{/hasitemmutes}}
    {{#hasitemmutes}}
        <table class="table table-striped generaltable">
            <thead><tr>
                <th scope="col">{{#str}} check, local_auditenhance {{/str}}</th>
                <th scope="col">{{#str}} muteditem, local_auditenhance {{/str}}</th>
                <th scope="col">{{#str}} reason, local_auditenhance {{/str}}</th>
                <th scope="col">{{#str}} mutedby, local_auditenhance {{/str}}</th>
                <th scope="col"><span class="sr-only visually-hidden">{{#str}} actions {{/str}}</span></th>
            </tr></thead>
            <tbody>
                {{#itemmutes}}<tr>
                    <td>{{check}}</td>
                    <td>{{label}}</td>
                    <td>{{{reason}}}</td>
                    <td>{{user}}<br><small class="text-muted">{{time}}</small></td>
                    <td>{{#unmuteurl}}<a class="btn btn-sm btn-secondary" href="{{unmuteurl}}">{{#str}} unmute, local_auditenhance {{/str}}</a>{{/unmuteurl}}</td>
                </tr>{{/itemmutes}}
            </tbody>
        </table>
    {{/hasitemmutes}}
</div>
