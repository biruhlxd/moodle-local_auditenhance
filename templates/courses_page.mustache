{{!
    @template local_auditenhance/courses_page

    Issue counts per course.

    Example context (json):
    {
        "hasrun": true, "rundate": "26 November 2026", "total": 1, "hascourses": true, "pagingbar": "",
        "hasexports": false, "exports": [],
        "courses": [{"name": "Biology", "shortname": "BIO", "url": "#", "detailurl": "#", "items": 4,
                     "checks": [{"name": "Image alternative text", "count": 4}]}]
    }
}}
<div class="local-auditenhance-courses">
    {{^hasrun}}<div class="alert alert-info">{{#str}} noresultsyet, local_auditenhance {{/str}}</div>{{/hasrun}}
    {{#hasrun}}
        <p class="text-muted">{{#str}} lastrun, local_auditenhance, {{rundate}} {{/str}}</p>
        {{> local_auditenhance/exports }}
        {{^hascourses}}<div class="alert alert-success">{{#str}} nocoursesissues, local_auditenhance {{/str}}</div>{{/hascourses}}
        {{#hascourses}}
            <table class="table table-striped generaltable">
                <thead>
                    <tr>
                        <th scope="col">{{#str}} course {{/str}}</th>
                        <th scope="col">{{#str}} issues, local_auditenhance {{/str}}</th>
                        <th scope="col">{{#str}} bycheck, local_auditenhance {{/str}}</th>
                        <th scope="col"><span class="sr-only visually-hidden">{{#str}} details, local_auditenhance {{/str}}</span></th>
                    </tr>
                </thead>
                <tbody>
                    {{#courses}}
                        <tr>
                            <td><a href="{{url}}">{{name}}</a> <small class="text-muted">{{shortname}}</small></td>
                            <td>{{items}}</td>
                            <td><ul class="list-unstyled mb-0 small">{{#checks}}<li>{{name}}: {{count}}</li>{{/checks}}</ul></td>
                            <td><a href="{{detailurl}}">{{#str}} viewsample, local_auditenhance {{/str}}</a></td>
                        </tr>
                    {{/courses}}
                </tbody>
            </table>
            {{{pagingbar}}}
        {{/hascourses}}
    {{/hasrun}}
</div>
